# anet-vault-signer config — DO NOT COMMIT real values.
# Copy to .env and fill in.

# Your single signer private key (one of the 3 vault signers).
# Treat this like a Bitcoin seed. Keep this file chmod 600.
SIGNER_PRIVATE_KEY=0xREPLACE_ME_32_BYTE_HEX

# L1 chain HTTP base URL.
L1_BASE_URL=https://anet-chain.example.com

# L1 admin key (issued by the operator) — only used to GET /bridge/burns.
L1_ADMIN_KEY=replace-me

# AnetBridgeVault contract on BSC mainnet (deployed 2026-05).
VAULT_ADDRESS=0x31438362a7667ce5559500023D025c7c14168B49
VAULT_CHAIN_ID=56

# Poll interval & safety cap.
POLL_INTERVAL_MS=30000
MAX_AMOUNT_ANET_PER_BURN=10000
